tip[ label="tiempo maximode espera: 15.0"style="filled",fillcolor="#ffbb3344"]
tm[ label="tiempo minimode espera: 10.0"style="filled",fillcolor="#ffbb3344"]
cli[shape=plaintext ,label =<<TABLE><TR><TD>CLIENTES EN LA COLA</TD></TR><TR><TD>DPI:3004379830101  Nombre:Adolfo</TD></TR><TR><TD>DPI:3406359830101  Nombre:Sofia</TD></TR><TR><TD>DPI:3408359830101  Nombre:Carlos</TD></TR><TR><TD>DPI:3848359830101  Nombre:Alejandra</TD></TR></TABLE>>];
ac -> in  [ style=invis ]
no -> pu  [ style=invis ]
